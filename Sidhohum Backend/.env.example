# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sidhohum_cafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sidhohum_cafe

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials (for seed script / initial setup)
DEFAULT_ADMIN_PHONE=7906691723
DEFAULT_ADMIN_PASSWORD=Avadesh@Arsh
DEFAULT_ADMIN_NAME="Cafe Owner"

# Real OTP Provider Configuration
# Supported providers: "development" (logs to server console & test response), "twilio", "fast2sms", "msg91"
OTP_PROVIDER=development

# Twilio SMS / WhatsApp Configuration (Required if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Fast2SMS Configuration (Required if OTP_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Cloudinary Image Storage (Optional, for menu image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cafe Local Timezone
CAFE_TIMEZONE=Asia/Kolkata

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
